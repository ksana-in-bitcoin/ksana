# The settings of the hosted public signet (signet/docker-compose.yml, D-107). signet/deploy.sh setup writes the real
# file to /opt/ksana-signet/.env on the server, with a random password; this file only documents the variables.

# Where the keys and the genesis config live on the server (config/), next to this file
KSANA_SIGNET_HOME=/opt/ksana-signet
# bitcoind's RPC: the services log in as "ksana" with this password; bitcoind keeps only its salted hash (-rpcauth,
# user:salt$hmac-sha256(salt, password); single quotes keep compose from reading $ as a variable)
BTC_RPC_PASS=<48 random hex digits>
BTC_RPCAUTH='ksana:<salt>$<hmac>'
# The site Caddy serves and takes a certificate for; without a domain of its own, <ip with dashes>.sslip.io
KSANA_SIGNET_DOMAIN=signet.example.org
# The name the signet had before, if any (signet/Caddyfile, D-112; setup --former): /rpc, /indexer, /btc and /faucet
# still answer there and the page moves to KSANA_SIGNET_DOMAIN; its A record points here too (DNS only)
KSANA_SIGNET_FORMER_DOMAIN=
# The origin of the contract playground's page (D-119; setup --playground <name> writes https://<name>), which a
# Cloudflare Worker serves (playground/wrangler.jsonc): empty for none. Set, it adds the playground profile, the compile
# service at /compile, and lets that page call the faucet and the compile service from its origin
KSANA_PLAYGROUND_ORIGIN=
# The origin of the testnet points page (D-126; setup --points <name> writes https://<name>), which a Cloudflare Worker
# serves (wrangler.jsonc of ksana-points): empty for none. Set, it adds the points profile, the points service at
# /points with the official lending market's price keeper, and lets that page call /points from its origin
KSANA_POINTS_ORIGIN=
# Cloudflare Turnstile at the points page's sign-in, when both are set (the widget's secret and site keys)
KSANA_POINTS_TURNSTILE_SECRET=
KSANA_POINTS_TURNSTILE_SITEKEY=
# Producing seed nodes: 1 (node1), or 2 (node1 and node2, for 4 cores or more); also picks the genesis difficulty
KSANA_SIGNET_PRODUCERS=1
# The seed node the faucet sends through: node2 when there are two (setup sets it), so that the page's /rpc, served by
# node1, cannot cut the faucet off; the points service and the keeper use it too
KSANA_FAUCET_NODE=node1
# KSA per faucet request, and how long an account waits before asking again
KSANA_FAUCET_KSA=100
KSANA_FAUCET_COOLDOWN_HOURS=24
# The deployed commits (deploy.sh push sets them, signet/sources.sh): this repository's, ksana-web's, which the page's
# build shows, and ksana-points' (empty without the points service)
KSANA_COMMIT=
KSANA_WEB_COMMIT=
KSANA_POINTS_COMMIT=
