// The Cloudflare Worker that serves the contract playground at playground.ksana.network (D-119): static files only, no
// Worker script, as for the project's site (wrangler.jsonc of ksana-site). The page calls the signet's server across origins, as
// hosted/deployment.json names it: node1's JSON-RPC, the faucet and the compile service at signet.ksana.network, which
// allow this origin (signet/README.md, "The contract playground"). Workers Builds, with this directory as the root
// directory, runs the build command `npm run build:hosted` (set in the dashboard: Workers Builds ignores `build` below),
// which builds the TypeScript SDK, then the page with the hosted files (hosted/), then `npx wrangler deploy` in this
// directory, which attaches the name below to the Worker; Cloudflare creates its DNS record and certificate.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ksana-playground",
  "compatibility_date": "2026-10-01",
  // a deploy from a machine (npx wrangler deploy) builds the page first, as Workers Builds does
  "build": { "command": "npm run build:hosted" },
  "assets": {
    // index.html with hash routes, so every path is a file; the headers are hosted/_headers
    "directory": "./dist"
  },
  "routes": [{ "pattern": "playground.ksana.network", "custom_domain": true }],
  // no ksana-playground.<account>.workers.dev copy of the page; the builds of other branches still get a preview URL,
  // whose page reaches the node but not the faucet or the compile service, which allow playground.ksana.network alone
  "workers_dev": false,
  "preview_urls": true,
  "send_metrics": false
}
